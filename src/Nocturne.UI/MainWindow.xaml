<Window x:Class="Nocturne.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Penumbra">
  <Grid x:Name="Root" Background="Transparent" RequestedTheme="Dark" Loaded="MainWindow_Loaded" SizeChanged="Root_SizeChanged">
    <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid x:Name="TitleBar" Margin="22,0,150,0">
      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <Image x:Name="TitleAppIcon" Width="22" Height="22" AutomationProperties.Name="Penumbra 图标">
          <Image.Source><BitmapImage UriSource="ms-appx:///Assets/AppIcon.png" DecodePixelWidth="64"/></Image.Source>
        </Image>
        <TextBlock Text="Penumbra" FontSize="15" FontWeight="SemiBold"/>
      </StackPanel>
    </Grid>
    <ScrollViewer x:Name="SettingsScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <Grid x:Name="SettingsLayout" Margin="32,16,32,24" ColumnSpacing="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition x:Name="PreviewColumn" Width="*" MinWidth="300"/><ColumnDefinition x:Name="ParameterColumn" Width="340"/></Grid.ColumnDefinitions>
        <StackPanel x:Name="PreviewPanel" Grid.RowSpan="2" Spacing="16">
          <TextBlock x:Name="PreviewTitle" Text="桌面预览" FontSize="20" FontWeight="SemiBold"/>
          <Border CornerRadius="10" BorderBrush="#30FFFFFF" BorderThickness="1" Background="#FF111111">
            <Grid Height="330" x:Name="PreviewHost" SizeChanged="Preview_SizeChanged">
              <Canvas x:Name="PreviewCanvas" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
              <TextBlock x:Name="PreviewEmpty" Text="正在刷新壁纸…" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </Grid>
          </Border>
          <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Button x:Name="CaptureButton" Content="刷新壁纸" Click="CapturePreview_Click"/>
            <StackPanel x:Name="WallpaperEngineIndicator" Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="0,0,24,0" HorizontalAlignment="Right" VerticalAlignment="Center" AutomationProperties.Name="Wallpaper Engine 活动状态：正在检测" ToolTipService.ToolTip="正在检测当前会话的 Wallpaper Engine 进程">
              <Ellipse x:Name="WallpaperEngineDot" Width="7" Height="7" Fill="#FF8B9098" VerticalAlignment="Center"/>
              <TextBlock x:Name="WallpaperEngineLabel" Text="Wallpaper Engine 活动状态" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>
          </Grid>
          <ToggleSwitch x:Name="StartupToggle" Header="登录时自启动" OnContent="已开启" OffContent="已关闭"/>
          <StackPanel x:Name="ExperimentalPanel" Spacing="16" Margin="0,12,0,0">
            <TextBlock x:Name="BlurTitle" Text="实验性功能" FontSize="20" FontWeight="SemiBold"/>
            <StackPanel Spacing="10">
              <ToggleSwitch x:Name="BlurEnabledCheckBox" OnContent="已开启" OffContent="已关闭" Toggled="BlurOption_Changed">
                <ToggleSwitch.Header><TextBlock Text="窗口成为焦点时模糊桌面" TextWrapping="Wrap"/></ToggleSwitch.Header>
              </ToggleSwitch>
              <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="112"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="模糊半径" VerticalAlignment="Center"/>
                <NumberBox x:Name="BlurRadiusBox" Grid.Column="1" AutomationProperties.Name="模糊半径（像素）" Minimum="0" Maximum="48" Value="12" SmallChange="1" LargeChange="8" SpinButtonPlacementMode="Compact" ValueChanged="BlurRadiusBox_Changed"/>
                <TextBlock Grid.Column="2" Text="px" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
              </Grid>
              <Slider x:Name="BlurRadiusSlider" AutomationProperties.Name="模糊半径" Minimum="0" Maximum="48" StepFrequency="1" SmallChange="1" LargeChange="8" Value="12" ManipulationMode="None" ValueChanged="BlurRadius_Changed"/>
            </StackPanel>
            <StackPanel x:Name="SaturationSection" Spacing="10">
              <ToggleSwitch x:Name="SaturationEnabledCheckBox" OnContent="已开启" OffContent="已关闭" IsEnabled="False" Toggled="SaturationOption_Changed">
                <ToggleSwitch.Header><TextBlock Text="窗口成为焦点时降低饱和度" TextWrapping="Wrap"/></ToggleSwitch.Header>
              </ToggleSwitch>
              <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="112"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="饱和度" VerticalAlignment="Center"/>
                <NumberBox x:Name="SaturationBox" Grid.Column="1" AutomationProperties.Name="饱和度（百分比）" Minimum="0" Maximum="100" Value="40" SmallChange="1" LargeChange="10" SpinButtonPlacementMode="Compact" ValueChanged="SaturationBox_Changed"/>
                <TextBlock Grid.Column="2" Text="%" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
              </Grid>
              <Slider x:Name="SaturationSlider" AutomationProperties.Name="饱和度" Minimum="0" Maximum="100" StepFrequency="1" SmallChange="1" LargeChange="10" Value="40" ManipulationMode="None" ValueChanged="Saturation_Changed" ToolTipService.ToolTip="0% 为黑白，100% 保留原色"/>
              <TextBlock x:Name="SaturationAvailabilityText" Text="检测 Wallpaper Engine…" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
            </StackPanel>
          </StackPanel>
        </StackPanel>
          <Border x:Name="AboutSection" Grid.Row="1" Grid.Column="1" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="8,24,0,0" Padding="0,16,0,0" VerticalAlignment="Top">
            <StackPanel Spacing="12">
              <TextBlock Text="关于" FontSize="14" FontWeight="SemiBold"/>
              <Border Background="#08FFFFFF" CornerRadius="12" Padding="12">
              <Grid RowSpacing="16">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="1"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Grid x:Name="AboutProductInfo" ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Image x:Name="AboutAppIcon" Width="48" Height="48" VerticalAlignment="Center" AutomationProperties.Name="Penumbra 软件图标">
                  <Image.Source><BitmapImage UriSource="ms-appx:///Assets/AppIcon.png" DecodePixelWidth="128"/></Image.Source>
                </Image>
                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                    <TextBlock x:Name="AboutAppName" Text="Penumbra" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock x:Name="AboutVersionText" Text="{x:Bind DisplayVersion}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                  </StackPanel>
                  <HyperlinkButton x:Name="ProjectLink" Grid.Column="2" NavigateUri="https://github.com/Coldtea233/Penumbra" AutomationProperties.Name="Penumbra 项目主页" ToolTipService.ToolTip="在浏览器中打开 Penumbra 项目" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Background="{ThemeResource ControlFillColorDefaultBrush}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6" MinHeight="32" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="项目主页" FontSize="12"/>
                      <FontIcon Glyph="&#xE8A7;" FontSize="12"/>
                    </StackPanel>
                  </HyperlinkButton>
              </Grid>
              <Border Grid.Row="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>
              <Grid Grid.Row="2" ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <PersonPicture x:Name="AuthorAvatar" Width="36" Height="36" VerticalAlignment="Center" DisplayName="冷茶Reicha" AutomationProperties.Name="冷茶Reicha 的头像" AutomationProperties.AutomationId="AuthorAvatar">
                  <PersonPicture.ProfilePicture><BitmapImage UriSource="ms-appx:///Assets/AuthorAvatar.jpg" DecodePixelWidth="128" DecodePixelHeight="128"/></PersonPicture.ProfilePicture>
                </PersonPicture>
                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                <TextBlock x:Name="AuthorLabel" Text="开发者" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock x:Name="DeveloperName" Text="冷茶Reicha" FontSize="14" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                  <HyperlinkButton x:Name="BilibiliLink" NavigateUri="https://space.bilibili.com/485642246" AutomationProperties.Name="冷茶Reicha 的 bilibili 主页" ToolTipService.ToolTip="在浏览器中打开 bilibili 主页" Foreground="White" Padding="6" MinWidth="32" MinHeight="32">
                    <Path Width="20" Height="20" Stretch="Uniform" Fill="White" Data="M17.813 4.653h.854c1.51.054 2.769.578 3.773 1.574 1.004.995 1.524 2.249 1.56 3.76v7.36c-.036 1.51-.556 2.769-1.56 3.773s-2.262 1.524-3.773 1.56H5.333c-1.51-.036-2.769-.556-3.773-1.56S.036 18.858 0 17.347v-7.36c.036-1.511.556-2.765 1.56-3.76 1.004-.996 2.262-1.52 3.773-1.574h.774l-1.174-1.12a1.234 1.234 0 0 1-.373-.906c0-.356.124-.658.373-.907l.027-.027c.267-.249.573-.373.92-.373.347 0 .653.124.92.373L9.653 4.44c.071.071.134.142.187.213h4.267a.836.836 0 0 1 .16-.213l2.853-2.747c.267-.249.573-.373.92-.373.347 0 .662.151.929.4.267.249.391.551.391.907 0 .355-.124.657-.373.906zM5.333 7.24c-.746.018-1.373.276-1.88.773-.506.498-.769 1.13-.786 1.894v7.52c.017.764.28 1.395.786 1.893.507.498 1.134.756 1.88.773h13.334c.746-.017 1.373-.275 1.88-.773.506-.498.769-1.129.786-1.893v-7.52c-.017-.765-.28-1.396-.786-1.894-.507-.497-1.134-.755-1.88-.773zM8 11.107c.373 0 .684.124.933.373.25.249.383.569.4.96v1.173c-.017.391-.15.711-.4.96-.249.25-.56.374-.933.374s-.684-.125-.933-.374c-.25-.249-.383-.569-.4-.96V12.44c0-.373.129-.689.386-.947.258-.257.574-.386.947-.386zm8 0c.373 0 .684.124.933.373.25.249.383.569.4.96v1.173c-.017.391-.15.711-.4.96-.249.25-.56.374-.933.374s-.684-.125-.933-.374c-.25-.249-.383-.569-.4-.96V12.44c.017-.391.15-.711.4-.96.249-.249.56-.373.933-.373Z"/>
                  </HyperlinkButton>
                  <HyperlinkButton x:Name="GitHubLink" NavigateUri="https://github.com/Coldtea233" AutomationProperties.Name="Coldtea233 的 GitHub 主页" ToolTipService.ToolTip="在浏览器中打开 GitHub 主页" Foreground="White" Padding="6" MinWidth="32" MinHeight="32">
                    <Path Width="20" Height="20" Stretch="Uniform" Fill="White" Data="M6.766 11.328c-2.063-.25-3.516-1.734-3.516-3.656 0-.781.281-1.625.75-2.188-.203-.515-.172-1.609.063-2.062.625-.078 1.468.25 1.968.703.594-.187 1.219-.281 1.985-.281.765 0 1.39.094 1.953.265.484-.437 1.344-.765 1.969-.687.218.422.25 1.515.046 2.047.5.593.766 1.39.766 2.203 0 1.922-1.453 3.375-3.547 3.64.531.344.89 1.094.89 1.954v1.625c0 .468.391.734.86.547C13.781 14.359 16 11.53 16 8.03 16 3.61 12.406 0 7.984 0 3.563 0 0 3.61 0 8.031a7.88 7.88 0 0 0 5.172 7.422c.422.156.828-.125.828-.547v-1.25c-.219.094-.5.156-.75.156-1.031 0-1.64-.562-2.078-1.609-.172-.422-.36-.672-.719-.719-.187-.015-.25-.093-.25-.187 0-.188.313-.328.625-.328.453 0 .844.281 1.25.86.313.452.64.655 1.031.655s.641-.14 1-.5c.266-.265.47-.5.657-.656"/>
                  </HyperlinkButton>
                </StackPanel>
              </Grid>
              </Grid>
              </Border>
            </StackPanel>
          </Border>
        <StackPanel x:Name="ParameterPanel" Grid.Column="1" Spacing="14" Margin="8,8,0,0">
          <Grid Margin="0,0,0,4">
            <TextBlock Text="暗角参数" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Button Content="重置" HorizontalAlignment="Right" Click="Reset_Click" Style="{StaticResource SubtleButtonStyle}"/>
          </Grid>
          <StackPanel Spacing="2">
            <TextBlock Text="边缘强度"/>
            <Slider x:Name="OpacitySlider" AutomationProperties.Name="边缘强度" Minimum="0" Maximum="100" StepFrequency="1" Value="68" ValueChanged="Parameter_Changed"/>
          </StackPanel>
          <StackPanel Spacing="2">
            <TextBlock Text="中心半径"/>
            <Slider x:Name="RadiusSlider" AutomationProperties.Name="中心半径" Minimum="5" Maximum="150" StepFrequency="1" Value="48" ValueChanged="Parameter_Changed"/>
          </StackPanel>
          <StackPanel Spacing="2">
            <TextBlock Text="边缘羽化"/>
            <Slider x:Name="FeatherSlider" AutomationProperties.Name="边缘羽化" Minimum="5" Maximum="150" StepFrequency="1" Value="65" ValueChanged="Parameter_Changed"/>
          </StackPanel>
          <StackPanel Spacing="2">
            <TextBlock Text="长宽比"/>
            <Slider x:Name="ShapeSlider" AutomationProperties.Name="长宽比" Minimum="30" Maximum="250" StepFrequency="1" Value="100" ValueChanged="Parameter_Changed"/>
          </StackPanel>
          <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <NumberBox x:Name="CenterXBox" Header="中心 X / %" Minimum="0" Maximum="100" Value="50" SmallChange="5" SpinButtonPlacementMode="Compact" ValueChanged="NumericParameter_Changed"/>
            <NumberBox Grid.Column="1" x:Name="CenterYBox" Header="中心 Y / %" Minimum="0" Maximum="100" Value="50" SmallChange="5" SpinButtonPlacementMode="Compact" ValueChanged="NumericParameter_Changed"/>
          </Grid>
          <ComboBox x:Name="TintCombo" Header="暗角色调" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="DiscreteParameter_Changed">
            <ComboBoxItem Content="碳黑"/><ComboBoxItem Content="墨蓝"/><ComboBoxItem Content="暖黑"/>
          </ComboBox>
          <ComboBox x:Name="MonitorCombo" Header="屏幕范围" HorizontalAlignment="Stretch" SelectedIndex="0">
            <ComboBoxItem Content="所有屏幕 · 每屏独立暗角"/><ComboBoxItem Content="仅主屏幕"/>
          </ComboBox>
          <CheckBox x:Name="DarkenIconsCheckBox" Content="压暗桌面图标" Checked="IconOption_Changed" Unchecked="IconOption_Changed"/>
          <StackPanel Spacing="6" Margin="0,4,0,0">
            <CheckBox x:Name="FocusOnlyCheckBox" Content="前台无窗口时不启用暗角"/>
          </StackPanel>
        </StackPanel>
      </Grid>
    </ScrollViewer>
    <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="#30FFFFFF" Background="#B8181818" Padding="24,14">
      <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="StatusText" Text="Penumbra" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        <Button x:Name="StopButton" Grid.Column="1" Content="恢复桌面" Click="Stop_Click"/>
        <Button x:Name="ApplyButton" Grid.Column="2" Content="应用到桌面" Style="{StaticResource AccentButtonStyle}" Click="Apply_Click"/>
      </Grid>
    </Border>
  </Grid>
</Window>
