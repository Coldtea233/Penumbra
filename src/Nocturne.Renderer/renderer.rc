#include <winver.h>
1 24 "renderer.manifest"
1 VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Penumbra desktop vignette"
            VALUE "FileVersion", "0.1.0.0"
            VALUE "ProductName", "Penumbra"
            VALUE "ProductVersion", "Beta 0.1"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
