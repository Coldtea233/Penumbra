#include <winver.h>
1 24 "renderer.manifest"
101 ICON "../../assets/branding/AppIcon.ico"
102 ICON "../../assets/branding/TrayWhite.ico"
103 ICON "../../assets/branding/TrayBlack.ico"
1 VERSIONINFO
FILEVERSION 1,8,0,0
