        BEGIN
            VALUE "FileDescription", "Penumbra desktop effects"
            VALUE "FileVersion", "1.8.0.0"
            VALUE "ProductName", "Penumbra"
            VALUE "ProductVersion", "v1.8.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
